# PERF — environment variable names only. Do not put real secrets here.
# Copy to `.env` locally. Grok App Builder injects these on deploy and must
# not use a committed `.env` file.

# Postgres (Neon / any Postgres). When unset, local preview uses PGLite.
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
VITE_AUTH_ENABLED=true

# xAI Grok (server-only). When unset, local KPI architect fallback is used.
XAI_API_KEY=

# Grok auth broker (optional; defaults exist for Grok preview)
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Public hostname of a published grok.me app (injected on publish)
VITE_PUBLIC_HOSTNAME=
